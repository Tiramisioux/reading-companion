[
  {"name": "mixed-marks-baseline",
   "pages": [{"page": {"highlight": {"5": "yellow", "6": "teal", "7": "teal"}, "underline": [12], "margin_line": [16, 18], "seed": 1},
              "expect": {"marked": [[5, 7], [12, 12], [16, 18]], "shown": [[4, 8], [11, 13], [15, 19]],
                         "colors_start": {"0": ["yellow", "teal"]},
                         "kinds_include": {"0": ["highlight"], "1": ["underline"], "2": ["margin_line"]}}}]},
  {"name": "rotated-with-margin-note",
   "pages": [{"page": {"highlight": {"3": "pink", "20": "orange"}, "note_beside": 10, "angle": 2.5, "seed": 2},
              "expect": {"marked": [[3, 3], [9, 10], [20, 20]], "kinds_include": {"1": ["margin_note"]}}}]},
  {"name": "margin-note-owns-only-its-line",
   "known_issue": "a one-line side note with tall loops also takes the line above: bands.assign_lines adds 0.25 pitch to the note's extent before testing line centres",
   "pages": [{"page": {"highlight": {"3": "pink", "20": "orange"}, "note_beside": 10, "angle": 2.5, "seed": 2},
              "expect": {"marked": [[3, 3], [10, 10], [20, 20]], "kinds_include": {"1": ["margin_note"]}}}]},
  {"name": "unmarked-page-gives-nothing",
   "pages": [{"page": {"seed": 3}, "expect": {"marked": []}}]},
  {"name": "three-colours-consecutive-are-one-stripe",
   "pages": [{"page": {"highlight": {"5": "yellow", "6": "pink", "7": "green"}, "seed": 4},
              "expect": {"marked": [[5, 7]], "colors_start": {"0": ["yellow", "pink", "green"]}}}]},
  {"name": "one-unmarked-line-separates-and-is-shared",
   "pages": [{"page": {"highlight": {"5": "yellow", "7": "yellow"}, "seed": 5},
              "expect": {"marked": [[5, 5], [7, 7]], "shown": [[4, 6], [6, 8]]}}]},
  {"name": "underline-then-highlight-joins",
   "pages": [{"page": {"underline": [9], "highlight": {"10": "yellow"}, "seed": 6},
              "expect": {"marked": [[9, 10]], "kinds_include": {"0": ["underline", "highlight"]}}}]},
  {"name": "context-0-cuts-only-marked-lines", "context": 0,
   "pages": [{"page": {"highlight": {"8": "orange", "9": "orange"}, "seed": 7},
              "expect": {"marked": [[8, 9]], "shown": [[8, 9]]}}]},
  {"name": "context-2", "context": 2,
   "pages": [{"page": {"highlight": {"12": "teal"}, "seed": 8},
              "expect": {"marked": [[12, 12]], "shown": [[10, 14]]}}]},
  {"name": "first-and-last-body-lines",
   "pages": [{"page": {"highlight": {"1": "yellow", "24": "pink"}, "seed": 9},
              "expect": {"marked": [[1, 1], [24, 24]]}}]},
  {"name": "skew-minus-4-degrees",
   "pages": [{"page": {"highlight": {"6": "yellow", "7": "yellow"}, "underline": [15], "angle": -4.0, "seed": 10},
              "expect": {"marked": [[6, 7], [15, 15]]}}]},
  {"name": "long-margin-line",
   "pages": [{"page": {"margin_line": [3, 10], "seed": 11},
              "expect": {"marked": [[3, 10]], "kinds_include": {"0": ["margin_line"]}}}]},
  {"name": "folder-of-three-pages-in-order",
   "pages": [{"page": {"highlight": {"4": "yellow"}, "seed": 12}, "expect": {"marked": [[4, 4]]}},
             {"page": {"seed": 13}, "expect": {"marked": []}},
             {"page": {"underline": [18], "seed": 14}, "expect": {"marked": [[18, 18]]}}]},
  {"name": "ocr-reads-page-number", "needs_ocr": true,
   "pages": [{"page": {"highlight": {"5": "yellow"}, "head": "224          WAYFINDING", "seed": 15},
              "expect": {"marked": [[5, 5]], "page_number": "224"}}]}
]
